# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never commit real credentials.

# ── Email (real Email notifications — see docs/NOTIFICATIONS.md) ──────────
# Which provider src/lib/notifications/email/index.ts should use.
# Built in: "gmail". Add a new one there to support more.
EMAIL_PROVIDER=gmail

# Your own Gmail address + an App Password (NOT your normal password):
# Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── WhatsApp (real WhatsApp notifications — see docs/NOTIFICATIONS.md) ─────
# Which provider src/lib/notifications/whatsapp/index.ts should use.
# Built in: "baileys" (no keys needed — see setup below). Add a new one
# there (e.g. "twilio") to support more.
WHATSAPP_PROVIDER=baileys

# Baileys needs no env vars. On first run, watch the server terminal for a
# QR code and scan it with WhatsApp -> Linked Devices -> Link a Device on
# the phone that should send messages. The session is then saved to
# .baileys-auth/ (gitignored) so you don't need to re-scan on every restart.
